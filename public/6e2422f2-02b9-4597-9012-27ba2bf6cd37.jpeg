<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Gold gradient -->
    <linearGradient id="goldRim" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCE08B" />
      <stop offset="25%" stop-color="#DFAC42" />
      <stop offset="50%" stop-color="#B8860B" />
      <stop offset="75%" stop-color="#F9D776" />
      <stop offset="100%" stop-color="#996515" />
    </linearGradient>

    <!-- Flame gradient -->
    <linearGradient id="flameGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#D83018" />
      <stop offset="40%" stop-color="#F58220" />
      <stop offset="80%" stop-color="#FFD200" />
      <stop offset="100%" stop-color="#FFF5B8" />
    </linearGradient>

    <!-- Parchment radial background -->
    <radialGradient id="parchment" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="70%" stop-color="#FBF8EE" />
      <stop offset="100%" stop-color="#EFE8D3" />
    </radialGradient>

    <!-- Text Paths for arched text -->
    <!-- Top arc: from left to right along top -->
    <path id="topArc" d="M 62,250 A 188,188 0 1,1 438,250" fill="none" />
    <!-- Bottom arc: from left to right along bottom -->
    <path id="bottomArc" d="M 78,280 A 188,188 0 0,0 422,280" fill="none" />
  </defs>

  <!-- Outer Gold Rim -->
  <circle cx="250" cy="250" r="246" fill="url(#goldRim)" stroke="#805300" stroke-width="2" />
  <circle cx="250" cy="250" r="238" fill="none" stroke="#664400" stroke-width="1.5" />

  <!-- Navy Blue Ring -->
  <circle cx="250" cy="250" r="234" fill="#0D274F" stroke="#DFAC42" stroke-width="2.5" />

  <!-- Inner Gold Bevel Ring -->
  <circle cx="250" cy="250" r="168" fill="none" stroke="url(#goldRim)" stroke-width="5" />
  <circle cx="250" cy="250" r="164" fill="none" stroke="#7E560E" stroke-width="1.5" />

  <!-- Center Parchment Canvas -->
  <circle cx="250" cy="250" r="162" fill="url(#parchment)" />

  <!-- Top Text: COLLEGE OF TEACHER EDUCATION COUNCIL -->
  <text font-family="'Times New Roman', Georgia, serif" font-size="22.5" font-weight="bold" fill="#FCE08B" letter-spacing="2.8">
    <textPath href="#topArc" startOffset="50%" text-anchor="middle">
      COLLEGE OF TEACHER EDUCATION COUNCIL
    </textPath>
  </text>

  <!-- Separator Dots -->
  <circle cx="68" cy="348" r="5" fill="#FFFFFF" stroke="#0D274F" stroke-width="1" />
  <circle cx="432" cy="348" r="5" fill="#FFFFFF" stroke="#0D274F" stroke-width="1" />

  <!-- Bottom Text: THE NATIONAL ENGINEERING UNIVERSITY (Red) -->
  <text font-family="'Times New Roman', Georgia, serif" font-size="18" font-weight="bold" fill="#E52D27" letter-spacing="1.8">
    <textPath href="#bottomArc" startOffset="50%" text-anchor="middle">
      THE NATIONAL ENGINEERING UNIVERSITY
    </textPath>
  </text>

  <!-- Laurel Wreaths (Gold) -->
  <g fill="#DCA32B" stroke="#A67207" stroke-width="0.5">
    <!-- Left Laurel -->
    <path d="M 125,295 C 110,265 110,210 135,160 C 130,175 125,200 135,230 C 140,250 145,275 130,295 Z" opacity="0.4" />
    <path d="M 115,225 C 105,215 112,195 128,198 C 128,212 120,222 115,225 Z" />
    <path d="M 122,250 C 110,242 112,222 130,224 C 131,238 126,248 122,250 Z" />
    <path d="M 132,275 C 120,270 120,250 138,248 C 140,262 137,272 132,275 Z" />
    <path d="M 112,200 C 105,188 115,172 128,178 C 126,192 118,198 112,200 Z" />
    <path d="M 122,175 C 118,162 130,148 142,158 C 138,170 128,175 122,175 Z" />
    <path d="M 140,152 C 138,140 152,130 162,142 C 155,152 145,154 140,152 Z" />
    <path d="M 162,135 C 162,122 178,118 186,130 C 178,138 168,138 162,135 Z" />

    <!-- Right Laurel -->
    <path d="M 375,295 C 390,265 390,210 365,160 C 370,175 375,200 365,230 C 360,250 355,275 370,295 Z" opacity="0.4" />
    <path d="M 385,225 C 395,215 388,195 372,198 C 372,212 380,222 385,225 Z" />
    <path d="M 378,250 C 390,242 388,222 370,224 C 369,238 374,248 378,250 Z" />
    <path d="M 368,275 C 380,270 380,250 362,248 C 360,262 363,272 368,275 Z" />
    <path d="M 388,200 C 395,188 385,172 372,178 C 374,192 382,198 388,200 Z" />
    <path d="M 378,175 C 382,162 370,148 358,158 C 362,170 372,175 378,175 Z" />
    <path d="M 360,152 C 362,140 348,130 338,142 C 345,152 355,154 360,152 Z" />
    <path d="M 338,135 C 338,122 322,118 314,130 C 322,138 332,138 338,135 Z" />
  </g>

  <!-- 5 Stylized Blue Human Figures Reaching Up (Arc) -->
  <g fill="#10438E" stroke="#0B2E63" stroke-width="0.8">
    <!-- Center top figure -->
    <circle cx="250" cy="132" r="11" />
    <path d="M 233,165 C 233,148 240,146 250,146 C 260,146 267,148 267,165 C 267,180 258,192 250,195 C 242,192 233,180 233,165 Z" />
    <!-- Arms raised upward -->
    <path d="M 228,142 C 220,130 220,118 224,110 C 228,122 234,136 242,148 Z" />
    <path d="M 272,142 C 280,130 280,118 276,110 C 272,122 266,136 258,148 Z" />

    <!-- Left middle figure -->
    <circle cx="205" cy="155" r="10" />
    <path d="M 190,185 C 190,170 197,168 205,168 C 213,168 220,170 220,185 C 219,198 211,208 205,210 C 199,208 190,198 190,185 Z" />
    <path d="M 185,165 C 176,150 178,136 182,128 C 185,140 192,154 200,166 Z" />
    <path d="M 223,168 C 230,155 230,145 228,138 C 224,148 220,160 212,170 Z" />

    <!-- Right middle figure -->
    <circle cx="295" cy="155" r="10" />
    <path d="M 310,185 C 310,170 303,168 295,168 C 287,168 280,170 280,185 C 281,198 289,208 295,210 C 301,208 310,198 310,185 Z" />
    <path d="M 315,165 C 324,150 322,136 318,128 C 315,140 308,154 300,166 Z" />
    <path d="M 277,168 C 270,155 270,145 272,138 C 276,148 280,160 288,170 Z" />

    <!-- Far left figure -->
    <circle cx="170" cy="195" r="9.5" />
    <path d="M 158,222 C 158,210 164,207 170,207 C 176,207 182,210 182,222 C 181,232 175,240 170,242 C 165,240 158,232 158,222 Z" />
    <path d="M 152,204 C 142,192 144,178 150,170 C 151,182 158,195 166,205 Z" />
    <path d="M 186,208 C 194,196 195,188 193,182 C 189,190 184,200 177,210 Z" />

    <!-- Far right figure -->
    <circle cx="330" cy="195" r="9.5" />
    <path d="M 342,222 C 342,210 336,207 330,207 C 324,207 318,210 318,222 C 319,232 325,240 330,242 C 335,240 342,232 342,222 Z" />
    <path d="M 348,204 C 358,192 356,178 350,170 C 349,182 342,195 334,205 Z" />
    <path d="M 314,208 C 306,196 305,188 307,182 C 311,190 316,200 323,210 Z" />
  </g>

  <!-- Central Torch Flame -->
  <g>
    <!-- Outer orange/red flame -->
    <path d="M 250,180 C 242,200 232,215 235,232 C 238,245 246,252 250,252 C 254,252 262,245 265,232 C 268,215 258,200 250,180 Z" fill="url(#flameGrad)" />
    <!-- S-curve flame tongues -->
    <path d="M 250,175 C 240,195 245,215 238,228 C 234,215 242,202 248,188 Z" fill="#F58220" />
    <path d="M 250,175 C 255,190 262,205 257,222 C 261,212 258,198 252,185 Z" fill="#FFD200" />
    <!-- Inner bright yellow flame core -->
    <path d="M 250,205 C 245,218 244,228 247,238 C 249,244 251,245 250,245 C 249,245 251,244 253,238 C 256,228 255,218 250,205 Z" fill="#FFF8C4" />
  </g>

  <!-- Torch Base (Blue & Gold) -->
  <g>
    <!-- Torch bowl -->
    <path d="M 235,252 L 265,252 L 260,264 L 240,264 Z" fill="#10438E" stroke="#0B2E63" stroke-width="1" />
    <ellipse cx="250" cy="252" rx="15" ry="3.5" fill="#DFAC42" stroke="#A67207" stroke-width="0.8" />
    <!-- Torch shaft / fluted handle -->
    <path d="M 244,264 L 256,264 L 254,302 L 246,302 Z" fill="#10438E" stroke="#0B2E63" stroke-width="1" />
    <line x1="250" y1="264" x2="250" y2="302" stroke="#4177CA" stroke-width="1.2" />
    <!-- Torch lower knob -->
    <ellipse cx="250" cy="303" rx="6" ry="2.5" fill="#DFAC42" stroke="#A67207" stroke-width="0.8" />
  </g>

  <!-- Open Book (Directly beneath torch) -->
  <g>
    <!-- Book blue cover back -->
    <path d="M 172,316 C 210,314 240,305 250,306 C 260,305 290,314 328,316 L 325,322 C 288,320 258,311 250,312 C 242,311 212,320 175,322 Z" fill="#0D274F" />

    <!-- Pages Left -->
    <path d="M 175,314 C 210,312 238,302 249,305 L 249,313 C 238,310 210,320 175,322 Z" fill="#FFFFFF" stroke="#0D274F" stroke-width="1" />
    <!-- Left page lines -->
    <path d="M 185,315 C 205,313 225,307 245,307" stroke="#3A6BB7" stroke-width="1" fill="none" />
    <path d="M 183,318 C 204,316 225,310 245,310" stroke="#3A6BB7" stroke-width="1" fill="none" />

    <!-- Pages Right -->
    <path d="M 325,314 C 290,312 262,302 251,305 L 251,313 C 262,310 290,320 325,322 Z" fill="#FFFFFF" stroke="#0D274F" stroke-width="1" />
    <!-- Right page lines -->
    <path d="M 315,315 C 295,313 275,307 255,307" stroke="#3A6BB7" stroke-width="1" fill="none" />
    <path d="M 317,318 C 296,316 275,310 255,310" stroke="#3A6BB7" stroke-width="1" fill="none" />
  </g>

  <!-- Gold Ribbon: 2001 -->
  <g>
    <path d="M 218,328 C 234,324 266,324 282,328 L 278,337 C 264,334 236,334 222,337 Z" fill="#E8B84B" stroke="#9E6E09" stroke-width="0.8" />
    <text x="250" y="335" font-family="'Times New Roman', Georgia, serif" font-size="12" font-weight="bold" fill="#0D274F" text-anchor="middle">
      2001
    </text>
  </g>

  <!-- White Scroll Banner: BatStateU ARASOF-Nasugbu -->
  <g>
    <!-- Shadow / fold -->
    <path d="M 148,348 L 158,358 L 164,346 Z" fill="#C5BA9E" stroke="#8A7C5F" stroke-width="0.5" />
    <path d="M 352,348 L 342,358 L 336,346 Z" fill="#C5BA9E" stroke="#8A7C5F" stroke-width="0.5" />
    <!-- Banner main body -->
    <path d="M 152,347 C 190,336 310,336 348,347 C 342,367 290,378 250,378 C 210,378 158,367 152,347 Z" fill="#FFFFFF" stroke="#C8A03E" stroke-width="1.5" />
    <!-- Arched text path for banner -->
    <path id="bannerPath" d="M 160,358 C 205,372 295,372 340,358" fill="none" />
    <text font-family="'Times New Roman', Georgia, serif" font-size="13" font-weight="bold" fill="#0D274F">
      <textPath href="#bannerPath" startOffset="50%" text-anchor="middle">
        BatStateU ARASOF-Nasugbu
      </textPath>
    </text>
  </g>

  <!-- Bottom Gold Filigree / Flourish -->
  <path d="M 240,384 C 246,381 250,385 250,387 C 250,385 254,381 260,384 C 256,389 252,388 250,392 C 248,388 244,389 240,384 Z" fill="#DFAC42" stroke="#8C6207" stroke-width="0.5" />
</svg>
